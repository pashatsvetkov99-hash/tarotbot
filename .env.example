# Telegram Bot Token (от @BotFather)
BOT_TOKEN=your_bot_token_here

# GigaChat — авторизация (base64 от client_id:client_secret)
GIGACHAT_AUTH_KEY=your_base64_auth_key_here

# GigaChat scope: GIGACHAT_API_PERS (физлица) или GIGACHAT_API_CORP (юрлица)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Количество бесплатных раскладов для нового пользователя
FREE_USES=1

# Стоимость расклада в Telegram Stars
STARS_PRICE=50

# Сколько раскладов начисляется за оплату
PAID_CREDITS=5